<section>
  <h2>Agregar Nuevo Servicio</h2>
  
  <form id="create-service-form">
    <div>
      <label for="name">Nombre:</label>
      <input type="text" id="name" name="name" required />
    </div>

    <div>
      <label for="description">Descripción:</label>
      <input type="text" id="description" name="description" required />
    </div>

    <div>
      <label for="duration">Duración (minutos):</label>
      <input type="number" id="duration" name="duration" required min="1" />
    </div>

    <div>
      <label for="price">Precio:</label>
      <input type="number" id="price" name="price" required min="0" step="0.01" />
    </div>

    <div>
      <label for="category">Categoría:</label>
      <input type="text" id="category" name="category" required />
    </div>

    <button type="submit">Crear Servicio</button>
  </form>
</section>

<hr />

<section>
  <h2>Catálogo de Servicios</h2>

  {{#if error}}
    <p class="error-message">{{error}}</p>
  {{/if}}

  <div id="services-list">
    {{#if services.length}}
      {{#each services}}
        <article class="service-card" id="service-{{this._id}}">
          <h3>{{this.name}}</h3>
          <p><strong>Descripción:</strong> {{this.description}}</p>
          <p><strong>Categoría:</strong> {{this.category}}</p>
          <p><strong>Duración:</strong> {{this.duration}} min</p>
          <p><strong>Precio:</strong> ${{this.price}}</p>
          <p><strong>Estado:</strong> {{#if this.isAvailable}}Disponible{{else}}No disponible{{/if}}</p>
        </article>
      {{/each}}
    {{else}}
      <p id="empty-services">No hay servicios registrados actualmente.</p>
    {{/if}}
  </div>
</section>
